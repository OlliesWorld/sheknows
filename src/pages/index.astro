---
import SheKnows from '../components/SheKnows';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>She Knows — Women's Sports Fact-Checker</title>
    <link rel="icon" href="/ollie_toon.ico" />
    <meta name="description" content="Drop a claim about women's sports. She'll check her receipts." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,400;1,700;1,900&family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <main>
      <SheKnows client:load />
    </main>
    <footer
      class="text-center py-8 eyebrow"
      style="color: var(--ink-faint); font-size: 11px;"
    >
      2 fact-checks per day &nbsp;·&nbsp; powered by Gemini
    </footer>
  </body>
</html>
